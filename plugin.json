{
  "name": "calendar",
  "version": "0.6.0",
  "summary": "Multiple resource calendars and dashboard widget for Grit, powered by CalendarKit Pro",
  "description": "Adds /calendar and /calendar/<id> pages plus an optional dashboard widget. Each calendar reads two generated resources: one with a datetime field for the events, one linked by a relationship field for the rows. The edit form is built from the resource fields listed in the calendar config (apps/admin/config/calendar.ts on Next.js, apps/admin/src/config/calendar.ts on Vite), with configurable create, delete and click behaviour.",
  "requires": [],
  "goDeps": [],
  "nodeDeps": [
    {
      "name": "calendarkit-pro",
      "version": "2.0.0",
      "workspace": "apps/admin"
    }
  ],
  "nextSteps": [
    "pnpm install",
    "Edit the calendar config: apps/admin/config/calendar.ts for Next.js, apps/admin/src/config/calendar.ts for Vite",
    "Open /calendar, or /calendar/<id> for the other entries in CALENDARS"
  ],
  "directories": [
    {
      "from": "files/shared/components/calendar",
      "to": "{{ADMIN_ROOT}}/components/calendar",
      "when": {
        "architecture": [
          "triple"
        ]
      }
    },
    {
      "from": "files/shared/config",
      "to": "{{ADMIN_ROOT}}/config",
      "when": {
        "architecture": [
          "triple"
        ]
      }
    },
    {
      "from": "files/next/components/calendar",
      "to": "{{ADMIN_ROOT}}/components/calendar",
      "when": {
        "architecture": [
          "triple"
        ],
        "frontend": [
          "next"
        ]
      }
    },
    {
      "from": "files/tanstack/components/calendar",
      "to": "{{ADMIN_ROOT}}/components/calendar",
      "when": {
        "architecture": [
          "triple"
        ],
        "frontend": [
          "tanstack"
        ]
      }
    },
    {
      "from": "files/next/app",
      "to": "{{ADMIN_ROOT}}/app",
      "when": {
        "architecture": [
          "triple"
        ],
        "frontend": [
          "next"
        ]
      }
    },
    {
      "from": "files/tanstack/routes",
      "to": "{{ADMIN_ROOT}}/routes",
      "when": {
        "architecture": [
          "triple"
        ],
        "frontend": [
          "tanstack"
        ]
      }
    },
    {
      "from": "files/shared/__tests__",
      "to": "apps/admin/__tests__",
      "when": {
        "architecture": [
          "triple"
        ]
      }
    },
    {
      "from": "files/next/__tests__",
      "to": "apps/admin/__tests__",
      "when": {
        "architecture": [
          "triple"
        ],
        "frontend": [
          "next"
        ]
      }
    }
  ],
  "injections": [
    {
      "file": "{{ADMIN_ROOT}}/components/chrome/CollapsibleSidebar.tsx",
      "marker": "// grit:nav:imports",
      "code": "import { CALENDAR_NAV } from \"@/config/calendar\";",
      "when": {
        "architecture": [
          "triple"
        ]
      }
    },
    {
      "file": "{{ADMIN_ROOT}}/components/chrome/CollapsibleSidebar.tsx",
      "marker": "// grit:nav:content",
      "code": "  ...CALENDAR_NAV,",
      "when": {
        "architecture": [
          "triple"
        ]
      }
    },
    {
      "file": "{{ADMIN_ROOT}}/lib/icons.ts",
      "marker": "// grit:icons:import",
      "code": "  CalendarDays,",
      "when": {
        "architecture": [
          "triple"
        ]
      }
    },
    {
      "file": "{{ADMIN_ROOT}}/lib/icons.ts",
      "marker": "// grit:icons:map",
      "code": "  CalendarDays,",
      "when": {
        "architecture": [
          "triple"
        ]
      }
    },
    {
      "file": "{{ADMIN_ROOT}}/lib/dashboard-catalog.ts",
      "marker": "// grit:dashboard:catalog",
      "code": "  { key: \"system:calendar\", kind: \"card\", module: \"Calendar\", moduleIcon: \"CalendarDays\", label: \"Calendar\", description: \"Upcoming events from the calendar plugin\" },",
      "when": {
        "architecture": [
          "triple"
        ]
      }
    },
    {
      "file": "{{ADMIN_ROOT}}/app/(dashboard)/dashboard/page.tsx",
      "marker": "// grit:dashboard:imports",

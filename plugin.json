    {
      "file": "{{ADMIN_ROOT}}/app/(dashboard)/dashboard/page.tsx",
      "marker": "{/* grit:dashboard:widgets */}",
      "code": "      <CalendarWidget />",
      "when": {
        "architecture": [
          "triple"
        ],
        "frontend": [
          "next"
        ]
      }
    },
    {
      "file": "{{ADMIN_ROOT}}/pages/dashboard.tsx",
      "marker": "{/* grit:dashboard:widgets */}",
      "code": "      <CalendarWidget />",
      "when": {
        "architecture": [
          "triple"
        ],
        "frontend": [
          "tanstack"
        ]
      }
    },
    {
      "file": "{{ADMIN_ROOT}}/components/resource/resource-page.tsx",
      "marker": "// grit:resource:imports",
      "code": "import { CalendarCreateIntent } from \"@/components/calendar/calendar-create-intent\";",
      "when": {
        "architecture": [
          "triple"
        ]
      }
    },
    {
      "file": "{{ADMIN_ROOT}}/components/resource/resource-page.tsx",
      "marker": "{/* grit:resource:slot */}",
      "code": "      <CalendarCreateIntent controller={c} slug={resource.slug} />",
      "when": {
        "architecture": [
          "triple"
        ]
      }
    }
  ]
}

      "when": {
        "architecture": [
          "triple"
        ],
        "frontend": [
          "next"
        ]
      }
    },
    {
      "file": "{{ADMIN_ROOT}}/pages/dashboard.tsx",
      "marker": "// grit:dashboard:imports",
      "code": "import { CalendarWidget } from \"@/components/calendar/calendar-widget\";",
      "when": {
        "architecture": [
          "triple"
        ],
        "frontend": [
          "tanstack"
        ]
      }
